generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

/**
 * ===================== ENUMS =====================
 */

enum EmailStatus {
  PENDING
  VERIFIED
}

enum KYCStatus {
  NOT_SUBMITTED
  PENDING
  APPROVED
  REJECTED
}

enum CampaignStatus {
  DRAFT
  PENDING_VERIFICATION
  LIVE
  SUSPENDED
  COMPLETED
}

enum DonationVisibility {
  PUBLIC
  ANONYMOUS
}

enum MoneyDonationStatus {
  PENDING
  COMPLETED
  FAILED
}

enum ItemDonationStatus {
  PLEDGED
  DELIVERED
  CONFIRMED
  REJECTED
}

enum AdminActionType {
  KYC_REVIEW
  CAMPAIGN_VERIFICATION
  ITEM_CONFIRMATION
  USER_SUSPENSION
  BADGE_GRANTED
  LEADERBOARD_FINALIZED
}

enum AuditActorType {
  ADMIN
  SYSTEM
}

enum BadgeType {
  FIRST_DONATION
  LIFETIME_AMOUNT
  CAMPAIGN_SUPPORTER
  ITEM_DONOR
  LEADERBOARD_WINNER
}

enum LeaderboardPeriod {
  MONTHLY
  CAMPAIGN
  YEARLY
}

/**
 * ===================== CORE MODELS =====================
 */

model User {
  id           String      @id @default(uuid())
  name         String
  email        String      @unique
  passwordHash String
  emailStatus  EmailStatus @default(PENDING)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  adminRole          AdminRole?
  kycProfile         KYCProfile?
  donorStats         DonorStats?
  campaigns          Campaign[]
  moneyDonations     MoneyDonation[]
  itemDonations      ItemDonation[]
  badges             UserBadge[]
  auditLogs          AuditLog[]         @relation("Actor")
  leaderboardEntries LeaderboardEntry[]
  updates            CampaignUpdate[]
  bestWishes         BestWish[]
  recurringDonations RecurringDonation[]
  bookmarks          Bookmark[]
  notifications      Notification[]
  comments           Comment[]

  @@index([email])
}

model AdminRole {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

/**
 * ===================== TRUST LAYER =====================
 */

model KYCProfile {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  documentType   String
  documentNumber String
  documentImage  String
  profilePhoto   String

  bankAccountName String
  bankAccountNo   String
  walletProvider  String?

  status          KYCStatus @default(PENDING)
  rejectionReason String?

  submittedAt DateTime  @default(now())
  reviewedAt  DateTime?
}

/**
 * ===================== CAMPAIGNS =====================
 */

model Campaign {
  id            String @id @default(uuid())
  beneficiaryId String
  beneficiary   User   @relation(fields: [beneficiaryId], references: [id])

  title        String
  description  String
  category     String         @default("general")
  district     String?        // Nepal district for map location
  coverImage   String  // relative path to cover image
  proofLinks   String? // JSON array of relative paths to proof files
  targetAmount Decimal        @db.Decimal(12, 2)
  status       CampaignStatus @default(PENDING_VERIFICATION)

  // Admin fields
  rejectionReason String?
  suspensionReason String?
  verifiedBy      String?  // Admin user ID who verified
  rejectedBy      String?  // Admin user ID who rejected
  suspendedBy     String?  // Admin user ID who suspended

  // Engagement metrics
  donationCount Int     @default(0)
  shareCount    Int     @default(0)
  visits        Int     @default(0)

  // Soft delete
  isActive Boolean @default(true)

  createdAt  DateTime  @default(now())
  verifiedAt DateTime?
  rejectedAt DateTime?
  suspendedAt DateTime?
  deletedAt  DateTime? // soft delete timestamp

  milestones     Milestone[]
  moneyDonations MoneyDonation[]
  itemDonations  ItemDonation[]
  updates            CampaignUpdate[]
  bestWishes         BestWish[]
  recurringDonations RecurringDonation[]
  bookmarks          Bookmark[]
  comments           Comment[]

  @@index([status])
  @@index([beneficiaryId])
  @@index([isActive])
  @@index([verifiedAt])
  @@index([category])
}

model Milestone {
  id         String   @id @default(uuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  title     String
  amount    Decimal @db.Decimal(12, 2)
  completed Boolean @default(false)

  fundsReleased  Boolean   @default(false)
  releasedAmount Decimal?  @db.Decimal(12, 2)
  releasedAt     DateTime?
  verifiedBy     String?
  claimStatus    String    @default("UNCLAIMED") // UNCLAIMED, CLAIMED, APPROVED, REJECTED
  claimProof     String?

  createdAt DateTime @default(now())
}

/**
 * ===================== CAMPAIGN UPDATES =====================
 */

model CampaignUpdate {
  id          String   @id @default(uuid())
  campaignId  String
  campaign    Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id])

  title       String
  content     String
  images      String   // JSON array of image URLs
  isMilestone Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([campaignId])
}

/**
 * ===================== BEST WISHES =====================
 */

model BestWish {
  id          String   @id @default(uuid())
  donationId  String   @unique
  donation    MoneyDonation @relation(fields: [donationId], references: [id])
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  campaignId  String
  campaign    Campaign @relation(fields: [campaignId], references: [id])

  message     String
  cardStyle   String   @default("simple")
  isAnonymous Boolean  @default(false)

  createdAt DateTime @default(now())

  @@index([campaignId])
  @@index([userId])
}

/**
 * ===================== DONATIONS =====================
 */

model MoneyDonation {
  id         String   @id @default(uuid())
  donorId    String
  donor      User     @relation(fields: [donorId], references: [id])
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id])

  amount     Decimal            @db.Decimal(12, 2)
  visibility DonationVisibility
  status     MoneyDonationStatus @default(PENDING)
  paymentRef String?            @unique
  pidx       String?            @unique

  createdAt DateTime @default(now())

  bestWish  BestWish?

  @@index([campaignId])
  @@index([donorId])
}

model ItemDonation {
  id         String   @id @default(uuid())
  donorId    String
  donor      User     @relation(fields: [donorId], references: [id])
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id])

  itemName      String
  quantity      String
  deliveryNote  String?
  deliveryPhoto String?

  status      ItemDonationStatus @default(PLEDGED)
  confirmedAt DateTime?

  createdAt DateTime @default(now())
}

/**
 * ===================== DONOR GAMIFICATION =====================
 */

model Badge {
  id          String      @id @default(uuid())
  code        String      @unique
  name        String
  description String
  iconUrl     String
  badgeType   BadgeType
  createdAt   DateTime    @default(now())
  userBadges  UserBadge[]
}

model UserBadge {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  badgeId   String
  badge     Badge    @relation(fields: [badgeId], references: [id])
  awardedAt DateTime @default(now())

  @@unique([userId, badgeId])
}

model DonorStats {
  userId String @id
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  totalMoneyDonated Decimal   @default(0) @db.Decimal(14, 2)
  totalItemCount    Int       @default(0)
  donationCount     Int       @default(0)
  lastDonationAt    DateTime?

  updatedAt DateTime @updatedAt
}

/**
 * ===================== LEADERBOARDS =====================
 */

model Leaderboard {
  id        String            @id @default(uuid())
  period    LeaderboardPeriod
  periodKey String
  createdAt DateTime          @default(now())

  entries LeaderboardEntry[]

  @@unique([period, periodKey])
}

model LeaderboardEntry {
  id            String      @id @default(uuid())
  leaderboardId String
  leaderboard   Leaderboard @relation(fields: [leaderboardId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id])

  rank        Int
  totalAmount Decimal @db.Decimal(12, 2)
  totalItems  Int
  isAnonymous Boolean @default(false)

  @@unique([leaderboardId, userId])
}

/**
 * ===================== RECURRING DONATIONS =====================
 */

model RecurringDonation {
  id           String    @id @default(uuid())
  donorId      String
  campaignId   String
  amount       Decimal   @db.Decimal(12, 2)
  frequency    String    // MONTHLY, WEEKLY
  status       String    @default("ACTIVE") // ACTIVE, PAUSED, CANCELLED
  nextDueDate  DateTime
  lastPaidDate DateTime?
  totalPaid    Decimal   @default(0) @db.Decimal(12, 2)
  paymentCount Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  donor        User      @relation(fields: [donorId], references: [id])
  campaign     Campaign  @relation(fields: [campaignId], references: [id])

  @@index([donorId])
  @@index([campaignId])
  @@index([status, nextDueDate])
}

/**
 * ===================== BOOKMARKS =====================
 */

model Bookmark {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([userId, campaignId])
  @@index([userId])
}

/**
 * ===================== NOTIFICATIONS =====================
 */

enum NotificationType {
  DONATION_RECEIVED
  CAMPAIGN_VERIFIED
  CAMPAIGN_REJECTED
  MILESTONE_COMPLETED
  BADGE_EARNED
  COMMENT_RECEIVED
  CAMPAIGN_UPDATE
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  message   String
  link      String?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([userId, isRead])
  @@index([userId, createdAt])
}

/**
 * ===================== COMMENTS =====================
 */

model Comment {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  content    String
  createdAt  DateTime @default(now())

  @@index([campaignId, createdAt])
}

/**
 * ===================== AUDIT LOG =====================
 */

model AuditLog {
  id        String         @id @default(uuid())
  actorType AuditActorType
  actorId   String?
  actor     User?          @relation("Actor", fields: [actorId], references: [id])

  actionType AdminActionType
  targetType String
  targetId   String

  note      String?
  createdAt DateTime @default(now())

  @@index([targetType, targetId])
}
