// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

/**
 * ===================== ENUMS =====================
 */

enum EmailStatus {
  PENDING
  VERIFIED
}

enum KYCStatus {
  NOT_SUBMITTED
  PENDING
  APPROVED
  REJECTED
}

enum CampaignStatus {
  DRAFT
  PENDING_VERIFICATION
  LIVE
  SUSPENDED
  COMPLETED
}

enum DonationVisibility {
  PUBLIC
  ANONYMOUS
}

enum ItemDonationStatus {
  PLEDGED
  DELIVERED
  CONFIRMED
  REJECTED
}

enum AdminActionType {
  KYC_REVIEW
  CAMPAIGN_VERIFICATION
  ITEM_CONFIRMATION
  USER_SUSPENSION
  BADGE_GRANTED
  LEADERBOARD_FINALIZED
}

enum AuditActorType {
  ADMIN
  SYSTEM
}

enum BadgeType {
  FIRST_DONATION
  LIFETIME_AMOUNT
  CAMPAIGN_SUPPORTER
  ITEM_DONOR
  LEADERBOARD_WINNER
}

enum LeaderboardPeriod {
  MONTHLY
  CAMPAIGN
  YEARLY
}

/**
 * ===================== CORE MODELS =====================
 */

model User {
  id           String      @id @default(uuid())
  name         String
  email        String      @unique
  passwordHash String
  emailStatus  EmailStatus @default(PENDING)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  adminRole          AdminRole?
  kycProfile         KYCProfile?
  donorStats         DonorStats?
  campaigns          Campaign[]
  moneyDonations     MoneyDonation[]
  itemDonations      ItemDonation[]
  badges             UserBadge[]
  auditLogs          AuditLog[]         @relation("Actor")
  leaderboardEntries LeaderboardEntry[]

  @@index([email])
}

model AdminRole {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

/**
 * ===================== TRUST LAYER =====================
 */

model KYCProfile {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  documentType   String
  documentNumber String
  documentImage  String
  profilePhoto   String

  bankAccountName String
  bankAccountNo   String
  walletProvider  String?

  status          KYCStatus @default(PENDING)
  rejectionReason String?

  submittedAt DateTime  @default(now())
  reviewedAt  DateTime?
}

/**
 * ===================== CAMPAIGNS =====================
 */

model Campaign {
  id            String @id @default(uuid())
  beneficiaryId String
  beneficiary   User   @relation(fields: [beneficiaryId], references: [id])

  title        String
  description  String
  coverImage   String
  proofLinks   String?
  targetAmount Decimal        @db.Decimal(12, 2)
  status       CampaignStatus @default(PENDING_VERIFICATION)

  createdAt  DateTime  @default(now())
  verifiedAt DateTime?

  milestones     Milestone[]
  moneyDonations MoneyDonation[]
  itemDonations  ItemDonation[]

  @@index([status])
}

model Milestone {
  id         String   @id @default(uuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  title     String
  amount    Decimal @db.Decimal(12, 2)
  completed Boolean @default(false)

  createdAt DateTime @default(now())
}

/**
 * ===================== DONATIONS =====================
 */

model MoneyDonation {
  id         String   @id @default(uuid())
  donorId    String
  donor      User     @relation(fields: [donorId], references: [id])
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id])

  amount     Decimal            @db.Decimal(12, 2)
  visibility DonationVisibility
  paymentRef String

  createdAt DateTime @default(now())

  @@index([campaignId])
  @@index([donorId])
}

model ItemDonation {
  id         String   @id @default(uuid())
  donorId    String
  donor      User     @relation(fields: [donorId], references: [id])
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id])

  itemName      String
  quantity      String
  deliveryNote  String?
  deliveryPhoto String?

  status      ItemDonationStatus @default(PLEDGED)
  confirmedAt DateTime?

  createdAt DateTime @default(now())
}

/**
 * ===================== DONOR GAMIFICATION =====================
 */

model Badge {
  id          String      @id @default(uuid())
  code        String      @unique
  name        String
  description String
  iconUrl     String
  badgeType   BadgeType
  createdAt   DateTime    @default(now())
  userBadges  UserBadge[]
}

model UserBadge {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  badgeId   String
  badge     Badge    @relation(fields: [badgeId], references: [id])
  awardedAt DateTime @default(now())

  @@unique([userId, badgeId])
}

model DonorStats {
  userId String @id
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  totalMoneyDonated Decimal   @default(0) @db.Decimal(14, 2)
  totalItemCount    Int       @default(0)
  donationCount     Int       @default(0)
  lastDonationAt    DateTime?

  updatedAt DateTime @updatedAt
}

/**
 * ===================== LEADERBOARDS =====================
 */

model Leaderboard {
  id        String            @id @default(uuid())
  period    LeaderboardPeriod
  periodKey String
  createdAt DateTime          @default(now())

  entries LeaderboardEntry[]

  @@unique([period, periodKey])
}

model LeaderboardEntry {
  id            String      @id @default(uuid())
  leaderboardId String
  leaderboard   Leaderboard @relation(fields: [leaderboardId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id])

  rank        Int
  totalAmount Decimal @db.Decimal(12, 2)
  totalItems  Int
  isAnonymous Boolean @default(false)

  @@unique([leaderboardId, userId])
}

/**
 * ===================== AUDIT LOG =====================
 */

model AuditLog {
  id        String         @id @default(uuid())
  actorType AuditActorType
  actorId   String?
  actor     User?          @relation("Actor", fields: [actorId], references: [id])

  actionType AdminActionType
  targetType String
  targetId   String

  note      String?
  createdAt DateTime @default(now())

  @@index([targetType, targetId])
}
