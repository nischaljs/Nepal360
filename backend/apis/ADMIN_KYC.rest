###############################################################################
#                        ADMIN KYC API DOCUMENTATION                        #
###############################################################################
#
# This API is for administrators to manage KYC profiles.
# Admins can list, view details, approve, and reject KYC submissions.
#
# Base URL: /api/admin/kyc
# Authentication: Bearer token with admin role (required for all routes)
#
###############################################################################

### 1. List KYC Profiles (Review Queue)
### Retrieve all KYC profiles with optional filtering by status.
###
### Query Parameters:
###   - status: PENDING | APPROVED | REJECTED
###
GET {{baseUrl}}/admin/kyc?status=PENDING
Authorization: Bearer {{adminToken}}

### Response (200 OK):
# [
#   {
#     "id": "kyc-uuid-1",
#     "userId": "user-uuid-1",
#     "documentType": "Passport",
#     "documentNumber": "P12345678",
#     "documentImage": "http://localhost:3000/uploads/kyc/user_id_1/passport.jpg",
#     "profilePhoto": "http://localhost:3000/uploads/kyc/user_id_1/profile.jpg",
#     "bankAccountName": "User One",
#     "bankAccountNo": "111122223333",
#     "walletProvider": "Esewa",
#     "status": "PENDING",
#     "rejectionReason": null,
#     "submittedAt": "2024-01-01T10:00:00Z",
#     "reviewedAt": null,
#     "user": {
#       "id": "user-uuid-1",
#       "name": "User One",
#       "email": "user1@example.com"
#     }
#   }
# ]

### Response (400 Bad Request - Invalid status filter):
# {
#   "message": "Invalid status filter."
# }

### 2. Get KYC Detail (Review Screen)
### Retrieve full details for a specific user's KYC profile, including user metadata and past audit logs.
###
### Parameters:
###   - userId: uuid of the user whose KYC profile is to be retrieved.
###
GET {{baseUrl}}/admin/kyc/user-uuid-1
Authorization: Bearer {{adminToken}}

